generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PropertyVisibility {
  PUBLIC
  SEGMENTED
  PRIVATE
}

enum ReservationStatus {
  HOLD
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum AvailabilityBlockReason {
  OWNER_HOLD
  MAINTENANCE
  OPS_HOLD
}

enum HousekeepingTaskStatus {
  SCHEDULED
  ASSIGNED
  IN_PROGRESS
  DONE
  BLOCKED
  CANCELLED
}

enum MaintenanceTicketStatus {
  OPEN
  TRIAGED
  SCHEDULED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum MaintenanceSeverity {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum StayQuoteStatus {
  AVAILABLE
  UNAVAILABLE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
}

enum ContractStatus {
  DRAFT
  ISSUED
  SIGNED
  ACTIVE
  VOID
  SUPERSEDED
}

enum LedgerEntryType {
  ACCOMMODATION
  TAX
  OTA_FEE
  PAYMENT_PROCESSING_FEE
  CLEANING
  KUQUBA_SERVICE_FEE
  OWNER_SHARE
  KUQUBA_SHARE
  MAINTENANCE_FUND
  OWNER_EXPENSE
  REFUND
  ADJUSTMENT
  SETTLEMENT
}

enum OwnerSettlementStatus {
  DRAFT
  READY_FOR_REVIEW
  APPROVED
  PAID
}

enum IdentityProvider {
  EMAIL_OTP
  PHONE_OTP
  OIDC
  PASSKEY
}

enum IdentityStatus {
  PENDING
  VERIFIED
  DISABLED
}

enum RoleScope {
  PLATFORM
  ORGANIZATION
  PROPERTY
  RESERVATION
}

enum StayProposalRequestStatus {
  NEW
  REVIEWING
  CONTACTED
  CLOSED
}

enum OwnerLeadStatus {
  NEW
  REVIEWING
  CONTACTED
  CLOSED
}

enum OpsCaseSourceType {
  OWNER_LEAD
  STAY_PROPOSAL_REQUEST
}

enum OpsCaseStatus {
  OPEN
  QUALIFYING
  ACTION_PENDING
  CLOSED
}

enum OpsTaskStatus {
  OPEN
  DONE
}

enum PropertyOnboardingStatus {
  DRAFT
  QUALIFICATION
  DOCUMENTS
  OPERATIONS_READY
  CLOSED
}

enum StayProposalStatus {
  DRAFT
  READY_TO_SEND
  SENT
  ACCEPTED
  DECLINED
  VOID
}

enum FormalApprovalStatus {
  DRAFT
  READY_FOR_APPROVAL
  APPROVED
  SENT
}

enum FormalDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

model Organization {
  id         String     @id @default(uuid())
  name       String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  users      User[]
  owners     Owner[]
  properties Property[]
}

model User {
  id                          String               @id @default(uuid())
  organizationId              String
  email                       String
  displayName                 String
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
  organization                Organization         @relation(fields: [organizationId], references: [id])
  identities                  Identity[]
  roles                       UserRole[]
  devSessions                 DevSession[]
  auditEvents                 AuditEvent[]
  opsCaseNotes                OpsCaseNote[]
  formalActivities            OpsFormalActivity[]
  formalDeliveries            OpsFormalDelivery[]
  assignedPropertyOnboardings PropertyOnboarding[] @relation("PropertyOnboardingAssignee")
  approvedPropertyOnboardings PropertyOnboarding[] @relation("PropertyOnboardingApprover")
  sentPropertyOnboardings     PropertyOnboarding[] @relation("PropertyOnboardingSender")
  assignedStayProposals       StayProposal[]       @relation("StayProposalAssignee")
  approvedStayProposals       StayProposal[]       @relation("StayProposalApprover")
  sentStayProposals           StayProposal[]       @relation("StayProposalSender")
  ownerProfile                Owner?               @relation("OwnerUser")
  guestProfile                Guest?               @relation("GuestUser")

  @@unique([organizationId, email])
}

model Identity {
  id         String           @id @default(uuid())
  userId     String
  provider   IdentityProvider
  subject    String
  status     IdentityStatus   @default(PENDING)
  verifiedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  user       User             @relation(fields: [userId], references: [id])
  challenges AuthChallenge[]

  @@unique([provider, subject])
  @@index([userId, status])
}

model Role {
  id          String           @id @default(uuid())
  key         String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now())
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UserRole {
  id               String    @id @default(uuid())
  userId           String
  roleId           String
  scope            RoleScope
  resourceId       String?
  assignedByUserId String?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id])
  role             Role      @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId, scope, resourceId])
  @@index([userId, scope, resourceId])
  @@index([roleId])
}

model AuthChallenge {
  id                String    @id @default(uuid())
  identityId        String?
  channel           String
  destinationHash   String
  purpose           String
  codeHash          String?
  deliveryProvider  String?
  providerMessageId String?
  deliveredAt       DateTime?
  deliveryError     String?
  expiresAt         DateTime
  consumedAt        DateTime?
  attempts          Int       @default(0)
  correlationId     String
  createdAt         DateTime  @default(now())
  identity          Identity? @relation(fields: [identityId], references: [id])

  @@index([destinationHash, purpose, createdAt])
  @@index([correlationId])
}

model DevSession {
  id               String    @id @default(uuid())
  userId           String
  audience         String
  sessionTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  lastSeenAt       DateTime?
  correlationId    String
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id])

  @@index([userId, audience, expiresAt])
  @@index([correlationId])
}

model Owner {
  id             String            @id @default(uuid())
  organizationId String
  userId         String?           @unique
  displayName    String
  email          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id])
  user           User?             @relation("OwnerUser", fields: [userId], references: [id])
  contracts      Contract[]
  tasks          OwnerTask[]
  documents      OwnerDocument[]
  settlements    OwnerSettlement[]
}

model Property {
  id                 String              @id @default(uuid())
  organizationId     String
  name               String
  destination        String
  neighborhood       String?
  summary            String?
  stayStyle          String?
  bookingNote        String?
  amenities          Json?
  houseRules         Json?
  operations         Json?
  visibility         PropertyVisibility  @default(PUBLIC)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organization       Organization        @relation(fields: [organizationId], references: [id])
  units              Unit[]
  stayCodes          StayCode[]
  images             PropertyImage[]
  availabilityBlocks AvailabilityBlock[]
  ratePlans          RatePlan[]
  contracts          Contract[]
  reservations       Reservation[]
  stayQuotes         StayQuote[]
  ownerTasks         OwnerTask[]
  ownerDocuments     OwnerDocument[]
  ownerSettlements   OwnerSettlement[]
  housekeepingTasks  HousekeepingTask[]
  maintenanceTickets MaintenanceTicket[]

  @@index([organizationId, destination])
}

model Unit {
  id                 String              @id @default(uuid())
  propertyId         String
  name               String
  maxGuests          Int
  bedrooms           Int
  bathrooms          Decimal             @db.Decimal(5, 2)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  property           Property            @relation(fields: [propertyId], references: [id])
  stayCodes          StayCode[]
  availabilityBlocks AvailabilityBlock[]
  ratePlans          RatePlan[]
  reservations       Reservation[]
  stayQuotes         StayQuote[]
  housekeepingTasks  HousekeepingTask[]
  maintenanceTickets MaintenanceTicket[]
}

model StayCode {
  id         String   @id @default(uuid())
  propertyId String
  unitId     String?
  code       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id])
  unit       Unit?    @relation(fields: [unitId], references: [id])

  @@unique([code])
  @@index([propertyId, active])
  @@index([unitId])
}

model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  url        String
  alt        String?
  sortOrder  Int      @default(0)
  isCover    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  property   Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId, sortOrder])
  @@index([propertyId, isCover])
}
model AvailabilityBlock {
  id         String                  @id @default(uuid())
  propertyId String
  unitId     String
  startsOn   DateTime
  endsOn     DateTime
  reason     AvailabilityBlockReason
  note       String?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  property   Property                @relation(fields: [propertyId], references: [id])
  unit       Unit                    @relation(fields: [unitId], references: [id])

  @@index([propertyId, startsOn, endsOn])
  @@index([unitId, startsOn, endsOn])
  @@index([reason, startsOn])
}

model RatePlan {
  id                 String    @id @default(uuid())
  propertyId         String
  unitId             String
  name               String
  currency           String    @default("GTQ")
  baseNightlyRate    Decimal   @db.Decimal(12, 2)
  weekendNightlyRate Decimal?  @db.Decimal(12, 2)
  cleaningFee        Decimal   @default(0) @db.Decimal(12, 2)
  serviceFeeBps      Int       @default(0)
  taxBps             Int       @default(0)
  minNights          Int       @default(1)
  startsOn           DateTime?
  endsOn             DateTime?
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  property           Property  @relation(fields: [propertyId], references: [id])
  unit               Unit      @relation(fields: [unitId], references: [id])

  @@index([propertyId, active])
  @@index([unitId, active])
  @@index([startsOn, endsOn])
}

model Contract {
  id                    String              @id @default(uuid())
  propertyId            String
  ownerId               String
  propertyOnboardingId  String?             @unique
  status                ContractStatus      @default(DRAFT)
  currentVersion        Int                 @default(1)
  title                 String?
  summary               String?
  termsSnapshot         Json?
  startsOn              DateTime
  endsOn                DateTime?
  ownerShareBps         Int
  kuqubaShareBps        Int
  issuedAt              DateTime?
  issuedByUserId        String?
  signedAt              DateTime?
  signedByUserId        String?
  signatureProvider     String?
  signatureProviderRef  String?             @unique
  signatureEvidenceHash String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  property              Property            @relation(fields: [propertyId], references: [id])
  owner                 Owner               @relation(fields: [ownerId], references: [id])
  propertyOnboarding    PropertyOnboarding? @relation(fields: [propertyOnboardingId], references: [id])
  versions              ContractVersion[]

  @@index([propertyId, ownerId])
  @@index([status, startsOn])
  @@index([propertyOnboardingId])
}

model ContractVersion {
  id              String    @id @default(uuid())
  contractId      String
  version         Int
  title           String
  summary         String
  termsSnapshot   Json
  createdByUserId String?
  createdAt       DateTime  @default(now())
  issuedAt        DateTime?
  contract        Contract  @relation(fields: [contractId], references: [id])

  @@unique([contractId, version])
  @@index([contractId, createdAt])
  @@index([createdByUserId])
}

model Guest {
  id           String        @id @default(uuid())
  userId       String?       @unique
  email        String
  fullName     String
  phone        String?
  countryCode  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User?         @relation("GuestUser", fields: [userId], references: [id])
  reservations Reservation[]

  @@index([email])
}

model Reservation {
  id                   String                @id @default(uuid())
  guestId              String
  propertyId           String
  unitId               String
  stayQuoteId          String?               @unique
  status               ReservationStatus     @default(HOLD)
  arrivalDate          DateTime
  departureDate        DateTime
  holdExpiresAt        DateTime?
  privateCode          String                @unique
  confirmationSource   String?
  currency             String?
  total                Decimal?              @db.Decimal(12, 2)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  guest                Guest                 @relation(fields: [guestId], references: [id])
  property             Property              @relation(fields: [propertyId], references: [id])
  unit                 Unit                  @relation(fields: [unitId], references: [id])
  stayQuote            StayQuote?            @relation(fields: [stayQuoteId], references: [id])
  payments             Payment[]
  ledgerEntries        LedgerEntry[]
  ownerSettlementLines OwnerSettlementLine[]
  housekeepingTasks    HousekeepingTask[]

  @@index([propertyId, arrivalDate, departureDate])
  @@index([unitId, arrivalDate, departureDate])
  @@index([guestId, status, arrivalDate])
  @@index([status, holdExpiresAt])
}

model StayQuote {
  id                String          @id @default(uuid())
  stayId            String
  propertyId        String
  unitId            String
  status            StayQuoteStatus
  unavailableReason String?
  arrivalDate       DateTime
  departureDate     DateTime
  nights            Int
  guests            Int
  currency          String
  nightlySubtotal   Decimal         @db.Decimal(12, 2)
  cleaningFee       Decimal         @db.Decimal(12, 2)
  serviceFee        Decimal         @db.Decimal(12, 2)
  tax               Decimal         @db.Decimal(12, 2)
  total             Decimal         @db.Decimal(12, 2)
  expiresAt         DateTime
  source            String          @default("public_stay_detail")
  correlationId     String
  ipAddress         String?
  createdAt         DateTime        @default(now())
  property          Property        @relation(fields: [propertyId], references: [id])
  unit              Unit            @relation(fields: [unitId], references: [id])
  reservation       Reservation?

  @@index([stayId, createdAt])
  @@index([propertyId, arrivalDate, departureDate])
  @@index([unitId, arrivalDate, departureDate])
  @@index([status, createdAt])
  @@index([correlationId])
}

model Payment {
  id             String        @id @default(uuid())
  reservationId  String
  provider       String
  providerRef    String        @unique
  idempotencyKey String?       @unique
  status         PaymentStatus @default(PENDING)
  amount         Decimal       @db.Decimal(12, 2)
  currency       String
  checkoutUrl    String?
  expiresAt      DateTime?
  confirmedAt    DateTime?
  failedAt       DateTime?
  failureReason  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  reservation    Reservation   @relation(fields: [reservationId], references: [id])

  @@index([reservationId, status])
  @@index([status, expiresAt])
}

model LedgerAccount {
  id        String        @id @default(uuid())
  name      String
  currency  String
  createdAt DateTime      @default(now())
  entries   LedgerEntry[]
}

model LedgerEntry {
  id                   String                @id @default(uuid())
  reservationId        String?
  ledgerAccountId      String
  type                 LedgerEntryType
  amount               Decimal               @db.Decimal(12, 2)
  currency             String
  memo                 String?
  createdAt            DateTime              @default(now())
  reservation          Reservation?          @relation(fields: [reservationId], references: [id])
  ledgerAccount        LedgerAccount         @relation(fields: [ledgerAccountId], references: [id])
  ownerSettlementLines OwnerSettlementLine[]

  @@index([reservationId, type])
}

model OwnerSettlement {
  id                 String                @id @default(uuid())
  ownerId            String
  propertyId         String?
  periodStart        DateTime
  periodEnd          DateTime
  status             OwnerSettlementStatus @default(DRAFT)
  currency           String
  grossAccommodation Decimal               @default(0) @db.Decimal(12, 2)
  cleaningFees       Decimal               @default(0) @db.Decimal(12, 2)
  taxes              Decimal               @default(0) @db.Decimal(12, 2)
  kuqubaServiceFees  Decimal               @default(0) @db.Decimal(12, 2)
  ownerExpenses      Decimal               @default(0) @db.Decimal(12, 2)
  adjustments        Decimal               @default(0) @db.Decimal(12, 2)
  ownerPayout        Decimal               @default(0) @db.Decimal(12, 2)
  generatedAt        DateTime              @default(now())
  reviewedAt         DateTime?
  approvedAt         DateTime?
  paidAt             DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  owner              Owner                 @relation(fields: [ownerId], references: [id])
  property           Property?             @relation(fields: [propertyId], references: [id])
  lines              OwnerSettlementLine[]

  @@index([ownerId, periodStart, periodEnd])
  @@index([propertyId, periodStart])
  @@index([status, periodEnd])
}

model OwnerSettlementLine {
  id            String          @id @default(uuid())
  settlementId  String
  ledgerEntryId String?
  reservationId String?
  type          LedgerEntryType
  label         String
  amount        Decimal         @db.Decimal(12, 2)
  currency      String
  occurredAt    DateTime        @default(now())
  sourceMemo    String?
  createdAt     DateTime        @default(now())
  settlement    OwnerSettlement @relation(fields: [settlementId], references: [id])
  ledgerEntry   LedgerEntry?    @relation(fields: [ledgerEntryId], references: [id])
  reservation   Reservation?    @relation(fields: [reservationId], references: [id])

  @@index([settlementId, occurredAt])
  @@index([ledgerEntryId])
  @@index([reservationId])
  @@index([type, occurredAt])
}

model StayProposalRequest {
  id            String                    @id @default(uuid())
  stayId        String
  stayName      String
  destination   String
  guestName     String
  email         String
  phone         String?
  arrivalDate   DateTime?
  departureDate DateTime?
  guests        Int
  message       String?
  status        StayProposalRequestStatus @default(NEW)
  source        String                    @default("public_stay_detail")
  correlationId String
  ipAddress     String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  stayProposal  StayProposal?

  @@index([stayId, status, createdAt])
  @@index([email, createdAt])
  @@index([correlationId])
}

model OwnerLead {
  id                 String              @id @default(uuid())
  ownerName          String
  email              String
  phone              String?
  propertyName       String?
  propertyType       String
  propertyLocation   String
  operatingStatus    String
  message            String?
  status             OwnerLeadStatus     @default(NEW)
  source             String              @default("public_owner_evaluate")
  correlationId      String
  ipAddress          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  propertyOnboarding PropertyOnboarding?

  @@index([email, createdAt])
  @@index([status, createdAt])
  @@index([correlationId])
}

model OpsCase {
  id                 String              @id @default(uuid())
  sourceType         OpsCaseSourceType
  sourceId           String
  title              String
  contactName        String
  contactEmail       String
  contactPhone       String?
  status             OpsCaseStatus       @default(OPEN)
  priority           String              @default("normal")
  nextStep           String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  notes              OpsCaseNote[]
  tasks              OpsCaseTask[]
  formalActivities   OpsFormalActivity[]
  formalDeliveries   OpsFormalDelivery[]
  propertyOnboarding PropertyOnboarding?
  stayProposal       StayProposal?

  @@unique([sourceType, sourceId])
  @@index([status, updatedAt])
  @@index([sourceType, updatedAt])
}

model OpsCaseNote {
  id           String   @id @default(uuid())
  opsCaseId    String
  authorUserId String?
  body         String
  createdAt    DateTime @default(now())
  opsCase      OpsCase  @relation(fields: [opsCaseId], references: [id])
  author       User?    @relation(fields: [authorUserId], references: [id])

  @@index([opsCaseId, createdAt])
  @@index([authorUserId])
}

model OpsCaseTask {
  id        String        @id @default(uuid())
  opsCaseId String
  title     String
  dueLabel  String?
  priority  String        @default("normal")
  status    OpsTaskStatus @default(OPEN)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  opsCase   OpsCase       @relation(fields: [opsCaseId], references: [id])

  @@index([opsCaseId, status, sortOrder])
}

model OpsFormalActivity {
  id          String   @id @default(uuid())
  opsCaseId   String
  actorUserId String?
  entityType  String
  entityId    String
  body        String
  createdAt   DateTime @default(now())
  opsCase     OpsCase  @relation(fields: [opsCaseId], references: [id])
  actor       User?    @relation(fields: [actorUserId], references: [id])

  @@index([opsCaseId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorUserId])
}

model OpsFormalDelivery {
  id                String               @id @default(uuid())
  idempotencyKey    String?              @unique
  opsCaseId         String
  actorUserId       String?
  entityType        String
  entityId          String
  channel           String
  provider          String
  providerMessageId String?
  templateKey       String
  templateVersion   Int
  status            FormalDeliveryStatus @default(PENDING)
  recipientHash     String
  recipientMasked   String
  subject           String
  errorCode         String?
  errorMessage      String?
  attemptCount      Int                  @default(0)
  maxAttempts       Int                  @default(3)
  nextAttemptAt     DateTime?
  lastAttemptAt     DateTime?
  acceptedAt        DateTime?
  createdAt         DateTime             @default(now())
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  opsCase           OpsCase              @relation(fields: [opsCaseId], references: [id])
  actor             User?                @relation(fields: [actorUserId], references: [id])

  @@index([opsCaseId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([providerMessageId])
  @@index([status, createdAt])
  @@index([status, nextAttemptAt])
  @@index([actorUserId])
}

model PropertyOnboarding {
  id                      String                   @id @default(uuid())
  opsCaseId               String                   @unique
  ownerLeadId             String                   @unique
  candidatePropertyName   String
  propertyType            String
  propertyLocation        String
  ownerName               String
  ownerEmail              String
  ownerPhone              String?
  status                  PropertyOnboardingStatus @default(DRAFT)
  nextMilestone           String
  checklist               Json
  assignedUserId          String?
  targetDate              DateTime?
  handoffNotes            String?
  approvalStatus          FormalApprovalStatus     @default(DRAFT)
  approvedAt              DateTime?
  approvedByUserId        String?
  sentAt                  DateTime?
  sentByUserId            String?
  deliveryNotes           String?
  deliveryStatus          FormalDeliveryStatus?
  deliveryProvider        String?
  providerMessageId       String?
  deliveryChannel         String?
  deliveryTemplateKey     String?
  deliveryTemplateVersion Int?
  deliveredAt             DateTime?
  deliveryFailedAt        DateTime?
  deliveryErrorCode       String?
  deliveryErrorMessage    String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  opsCase                 OpsCase                  @relation(fields: [opsCaseId], references: [id])
  ownerLead               OwnerLead                @relation(fields: [ownerLeadId], references: [id])
  assignedUser            User?                    @relation("PropertyOnboardingAssignee", fields: [assignedUserId], references: [id])
  approvedBy              User?                    @relation("PropertyOnboardingApprover", fields: [approvedByUserId], references: [id])
  sentBy                  User?                    @relation("PropertyOnboardingSender", fields: [sentByUserId], references: [id])
  contract                Contract?

  @@index([status, updatedAt])
  @@index([approvalStatus, updatedAt])
  @@index([deliveryStatus, updatedAt])
  @@index([providerMessageId])
  @@index([assignedUserId])
  @@index([approvedByUserId])
  @@index([sentByUserId])
  @@index([targetDate])
  @@index([propertyLocation])
}

model StayProposal {
  id                      String                @id @default(uuid())
  opsCaseId               String                @unique
  proposalRequestId       String                @unique
  stayId                  String
  stayName                String
  destination             String
  guestName               String
  guestEmail              String
  guestPhone              String?
  arrivalDate             DateTime?
  departureDate           DateTime?
  guests                  Int
  status                  StayProposalStatus    @default(DRAFT)
  currentVersion          Int                   @default(1)
  assignedUserId          String?
  targetDate              DateTime?
  handoffNotes            String?
  approvalStatus          FormalApprovalStatus  @default(DRAFT)
  approvedAt              DateTime?
  approvedByUserId        String?
  sentAt                  DateTime?
  sentByUserId            String?
  deliveryNotes           String?
  deliveryStatus          FormalDeliveryStatus?
  deliveryProvider        String?
  providerMessageId       String?
  deliveryChannel         String?
  deliveryTemplateKey     String?
  deliveryTemplateVersion Int?
  deliveredAt             DateTime?
  deliveryFailedAt        DateTime?
  deliveryErrorCode       String?
  deliveryErrorMessage    String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  opsCase                 OpsCase               @relation(fields: [opsCaseId], references: [id])
  proposalRequest         StayProposalRequest   @relation(fields: [proposalRequestId], references: [id])
  assignedUser            User?                 @relation("StayProposalAssignee", fields: [assignedUserId], references: [id])
  approvedBy              User?                 @relation("StayProposalApprover", fields: [approvedByUserId], references: [id])
  sentBy                  User?                 @relation("StayProposalSender", fields: [sentByUserId], references: [id])
  versions                StayProposalVersion[]

  @@index([status, updatedAt])
  @@index([approvalStatus, updatedAt])
  @@index([deliveryStatus, updatedAt])
  @@index([providerMessageId])
  @@index([assignedUserId])
  @@index([approvedByUserId])
  @@index([sentByUserId])
  @@index([targetDate])
  @@index([stayId, status])
}

model StayProposalVersion {
  id             String       @id @default(uuid())
  stayProposalId String
  version        Int
  title          String
  summary        String
  termsLabel     String
  internalNotes  String?
  createdAt      DateTime     @default(now())
  stayProposal   StayProposal @relation(fields: [stayProposalId], references: [id])

  @@unique([stayProposalId, version])
  @@index([stayProposalId, createdAt])
}

model HousekeepingTask {
  id            String                 @id @default(uuid())
  propertyId    String
  unitId        String?
  reservationId String?
  title         String
  status        HousekeepingTaskStatus @default(SCHEDULED)
  priority      String                 @default("normal")
  serviceDate   DateTime
  serviceWindow String?
  assigneeName  String?
  vendorName    String?
  checklist     Json
  notes         String?
  blockedReason String?
  completedAt   DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  property      Property               @relation(fields: [propertyId], references: [id])
  unit          Unit?                  @relation(fields: [unitId], references: [id])
  reservation   Reservation?           @relation(fields: [reservationId], references: [id])

  @@index([propertyId, status, serviceDate])
  @@index([unitId, serviceDate])
  @@index([reservationId])
  @@index([status, serviceDate])
}

model MaintenanceTicket {
  id              String                  @id @default(uuid())
  propertyId      String
  unitId          String?
  title           String
  category        String
  severity        MaintenanceSeverity     @default(MEDIUM)
  status          MaintenanceTicketStatus @default(OPEN)
  reportedAt      DateTime                @default(now())
  dueAt           DateTime?
  assigneeName    String?
  vendorName      String?
  description     String
  resolutionNotes String?
  completedAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  property        Property                @relation(fields: [propertyId], references: [id])
  unit            Unit?                   @relation(fields: [unitId], references: [id])

  @@index([propertyId, status, dueAt])
  @@index([unitId, status])
  @@index([severity, status])
  @@index([status, reportedAt])
}

model OwnerTask {
  id          String    @id @default(uuid())
  ownerId     String
  propertyId  String?
  title       String
  dueLabel    String
  priority    String
  ownerAction Boolean   @default(false)
  status      String    @default("OPEN")
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  owner       Owner     @relation(fields: [ownerId], references: [id])
  property    Property? @relation(fields: [propertyId], references: [id])

  @@index([ownerId, status, sortOrder])
  @@index([propertyId, status])
}

model OwnerDocument {
  id          String    @id @default(uuid())
  ownerId     String
  propertyId  String?
  label       String
  statusLabel String
  detail      String
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  owner       Owner     @relation(fields: [ownerId], references: [id])
  property    Property? @relation(fields: [propertyId], references: [id])

  @@index([ownerId, sortOrder])
  @@index([propertyId])
}

model AuditEvent {
  id            String   @id @default(uuid())
  actorUserId   String?
  action        String
  entityType    String
  entityId      String?
  previousValue Json?
  nextValue     Json?
  ipAddress     String?
  correlationId String
  result        String
  reason        String?
  createdAt     DateTime @default(now())
  actor         User?    @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([correlationId])
}
