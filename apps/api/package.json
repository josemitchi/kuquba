{
  "name": "@kuquba/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "predev": "npm run build --workspace @kuquba/config",
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run build --workspace @kuquba/config",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "pretypecheck": "npm run build --workspace @kuquba/config",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "preprisma:migrate": "npm run build --workspace @kuquba/config",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "preprisma:seed": "npm run build --workspace @kuquba/config",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "npm run build --workspace @kuquba/config && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/sensible": "^6.0.5",
    "@kuquba/config": "*",
    "@prisma/client": "^6.12.0",
    "fastify": "^5.12.1",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "prisma": "^6.12.0",
    "tsx": "^4.23.12"
  }
}
